# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ccss
# Used to sign QR tickets and other HMAC tokens. Generate: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Seat hold / order lifetime in minutes (Stripe Checkout minimum is 30)
SEAT_HOLD_MINUTES=30

# --- Email ---
# "smtp" (Mailpit in dev) or "resend" (production)
EMAIL_PROVIDER=smtp
EMAIL_FROM="CCSS <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# --- Stripe (stage d) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Uploads (stage b) ---
UPLOAD_DIR=./uploads
