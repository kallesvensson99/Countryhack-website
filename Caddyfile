# Automatic HTTPS (Let's Encrypt) for $SITE_DOMAIN. DNS A/AAAA must point at this server.
{$SITE_DOMAIN} {
	encode zstd gzip

	# Uploaded event images and sponsor logos are served straight from the volume.
	# Association documents (uploads/documents) are deliberately NOT: they go through the app, which checks who may see them.
	@images path /uploads/events/* /uploads/sponsors/*
	handle @images {
		uri strip_prefix /uploads
		root * /srv/uploads
		file_server
	}

	handle {
		# Caddy overwrites X-Forwarded-For with the real client IP (used for rate limiting & audit).
		reverse_proxy app:3000
	}
}
