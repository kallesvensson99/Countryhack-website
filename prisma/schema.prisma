// CCSS LAN party application — full schema (all stages).
// Money is always integer öre. Times are stored in UTC.
// Partial / expression unique indexes that Prisma cannot express live in
// prisma/migrations/*_raw_indexes/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum UserTagKind {
  FESTIVALLEDARE
  ADMIN
  ANSVARIG // may post and manage their own crew jobs
}

enum FaqGroup {
  TICKETS
  SEATS_FOOD
  ON_SITE
  ACCOUNT
}

enum CrewApplicationStatus {
  NEW
  ACCEPTED
  DECLINED
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ConsentKind {
  PRIVACY_POLICY
  TERMS
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum TicketStatus {
  PENDING
  ACTIVE
  CANCELLED
}

enum ChartObjectKind {
  TABLE
  STAGE
  ENTRANCE
  KITCHEN
  TOILET
  WALL
  LABEL
}

enum SeatClaimStatus {
  HELD
  CONFIRMED
}

enum FoodPurchaseStatus {
  PENDING
  ACTIVE
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum OrderItemKind {
  TICKET
  FOOD
}

enum PaymentKind {
  CHARGE
  REFUND
}

enum DiscountKind {
  PERCENT
  FIXED
}

enum DiscountAppliesTo {
  ALL
  TICKETS
  FOOD
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// ───────────────────── Accounts and security ─────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique // always stored lowercased
  passwordHash       String
  emailVerifiedAt    DateTime?
  realName           String
  nickname           String // unique case-insensitively via raw index on lower(nickname)
  birthDate          DateTime  @db.Date
  phone              String
  allergies          String?
  dietaryPreferences String?
  guardianName       String?
  guardianPhone      String?
  locale             String    @default("sv") // "sv" | "en"
  anonymizedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tags             UserTag[]
  sessions         Session[]
  authTokens       AuthToken[]
  consents         Consent[]
  tickets          Ticket[]
  orders           Order[]
  reservedSeats    Seat[]           @relation("SeatReservedFor")
  eventsCreated    Event[]          @relation("EventCreatedBy")
  checkedInTickets Ticket[]         @relation("TicketCheckedInBy")
  cancelledOrders  Order[]          @relation("OrderCancelledBy")
  collectedMeals   MealCollection[]
  broadcastsSent   Broadcast[]
  tagsGranted      UserTag[]        @relation("TagGrantedBy")
  auditLogs        AuditLog[]
  crewJobsCreated  CrewJob[]
  crewApplications CrewApplication[]
}

model UserTag {
  id          String      @id @default(cuid())
  userId      String
  tag         UserTagKind
  grantedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("TagGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, tag])
}

model Session {
  id        String   @id // sha256 hex of the cookie token; the token itself is never stored
  userId    String
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Consent {
  id         String      @id @default(cuid())
  userId     String
  kind       ConsentKind
  version    String
  acceptedAt DateTime    @default(now())
  ip         String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimit {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  eventId    String?
  diff       Json
  ip         String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([eventId])
  @@index([createdAt])
}

// ───────────────────────── Organization ─────────────────────────

model OrgSettings {
  id                   String   @id @default(cuid())
  name                 String   @default("Cable connectors spelsällskap (CCSS)")
  orgNumber            String?
  address              String?
  contactEmail         String?
  privacyPolicyVersion String   @default("1")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ───────────────────────── Events and tickets ─────────────────────────

model Event {
  id                   String      @id @default(cuid())
  slug                 String      @unique
  name                 String
  description          String
  imagePath            String?
  venueName            String
  address              String
  startsAt             DateTime
  endsAt               DateTime
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  minAge               Int         @default(14)
  status               EventStatus @default(DRAFT)
  seatChangeDeadline   DateTime?
  showNicknamesOnMap   Boolean     @default(false)
  createdById          String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  createdBy     User           @relation("EventCreatedBy", fields: [createdById], references: [id])
  ticketTypes   TicketType[]
  tickets       Ticket[]
  chart         SeatingChart?
  meals         Meal[]
  foodPackages  FoodPackage[]
  orders        Order[]
  discountCodes DiscountCode[]
  broadcasts    Broadcast[]
}

model TicketType {
  id                   String    @id @default(cuid())
  eventId              String
  name                 String
  description          String    @default("")
  priceOre             Int
  quantity             Int
  salesStartsAt        DateTime?
  salesEndsAt          DateTime?
  includesSeat         Boolean   @default(true)
  requiresDiscountCode Boolean   @default(false)
  hidden               Boolean   @default(false)
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  event       Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  zones       TicketTypeZone[]
  tickets     Ticket[]
  orderItems  OrderItem[]
  unlockCodes DiscountCodeTicketType[]

  @@index([eventId])
}

model TicketTypeZone {
  id           String   @id @default(cuid())
  ticketTypeId String
  zoneId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  zone       SeatZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([ticketTypeId, zoneId])
}

model Ticket {
  id            String       @id @default(cuid())
  eventId       String
  userId        String
  ticketTypeId  String
  orderId       String
  status        TicketStatus @default(PENDING)
  qrNonce       String
  checkedInAt   DateTime?
  checkedInById String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  event         Event          @relation(fields: [eventId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  ticketType    TicketType     @relation(fields: [ticketTypeId], references: [id])
  order         Order          @relation(fields: [orderId], references: [id])
  checkedInBy   User?          @relation("TicketCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  seatClaim     SeatClaim?
  foodPurchases FoodPurchase[]

  // One active ticket per member per event: partial unique index on
  // (eventId, userId) WHERE status <> 'CANCELLED' (raw migration).
  @@index([eventId, userId])
  @@index([orderId])
}

// ───────────────────────── Seating ─────────────────────────

model SeatingChart {
  id         String   @id @default(cuid())
  eventId    String?  @unique // null for templates
  name       String
  isTemplate Boolean  @default(false)
  width      Int      @default(1200)
  height     Int      @default(800)
  gridSize   Int      @default(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event   Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  zones   SeatZone[]
  seats   Seat[]
  objects ChartObject[]
}

model SeatZone {
  id        String   @id @default(cuid())
  chartId   String
  name      String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chart       SeatingChart     @relation(fields: [chartId], references: [id], onDelete: Cascade)
  seats       Seat[]
  ticketTypes TicketTypeZone[]

  @@index([chartId])
}

model Seat {
  id                String   @id @default(cuid())
  chartId           String
  label             String
  x                 Float
  y                 Float
  rotation          Float    @default(0)
  zoneId            String
  groupId           String?
  blocked           Boolean  @default(false)
  reservedForUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  chart           SeatingChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  zone            SeatZone     @relation(fields: [zoneId], references: [id])
  reservedForUser User?        @relation("SeatReservedFor", fields: [reservedForUserId], references: [id], onDelete: SetNull)
  claim           SeatClaim?

  @@unique([chartId, label])
  @@index([zoneId])
}

model ChartObject {
  id        String          @id @default(cuid())
  chartId   String
  kind      ChartObjectKind
  x         Float
  y         Float
  width     Float
  height    Float
  rotation  Float           @default(0)
  label     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  chart SeatingChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@index([chartId])
}

model SeatClaim {
  id        String          @id @default(cuid())
  seatId    String          @unique
  ticketId  String          @unique
  status    SeatClaimStatus
  expiresAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  seat   Seat   @relation(fields: [seatId], references: [id])
  ticket Ticket @relation(fields: [ticketId], references: [id])
}

// ───────────────────────── Food ─────────────────────────

model Meal {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  servedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  packages    FoodPackageMeal[]
  collections MealCollection[]

  @@index([eventId])
}

model FoodPackage {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String   @default("")
  priceOre    Int
  quantity    Int?
  salesEndsAt DateTime
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  meals      FoodPackageMeal[]
  variants   FoodVariant[]
  purchases  FoodPurchase[]
  orderItems OrderItem[]

  @@index([eventId])
}

model FoodPackageMeal {
  id        String   @id @default(cuid())
  packageId String
  mealId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package FoodPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  meal    Meal        @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([packageId, mealId])
}

model FoodVariant {
  id        String   @id @default(cuid())
  packageId String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package    FoodPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  purchases  FoodPurchase[]
  orderItems OrderItem[]

  @@index([packageId])
}

model FoodPurchase {
  id                String             @id @default(cuid())
  orderId           String
  ticketId          String
  packageId         String
  variantId         String
  allergiesSnapshot String?
  status            FoodPurchaseStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  order       Order            @relation(fields: [orderId], references: [id])
  ticket      Ticket           @relation(fields: [ticketId], references: [id])
  package     FoodPackage      @relation(fields: [packageId], references: [id])
  variant     FoodVariant      @relation(fields: [variantId], references: [id])
  collections MealCollection[]

  @@index([orderId])
  @@index([ticketId])
}

model MealCollection {
  id             String   @id @default(cuid())
  foodPurchaseId String
  mealId         String
  collectedAt    DateTime @default(now())
  collectedById  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  foodPurchase FoodPurchase @relation(fields: [foodPurchaseId], references: [id], onDelete: Cascade)
  meal         Meal         @relation(fields: [mealId], references: [id])
  collectedBy  User         @relation(fields: [collectedById], references: [id])

  @@unique([foodPurchaseId, mealId])
}

// ───────────────────────── Orders and payments ─────────────────────────

model Order {
  id             String      @id @default(cuid())
  number         String      @unique // CCSS-YYYY-NNNN, generated from the order_number_seq sequence in application code
  userId         String
  eventId        String
  status         OrderStatus @default(PENDING)
  subtotalOre    Int
  discountOre    Int         @default(0)
  totalOre       Int
  discountCodeId String?
  expiresAt      DateTime
  paidAt         DateTime?
  cancelledAt    DateTime?
  cancelledById  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  event         Event          @relation(fields: [eventId], references: [id])
  discountCode  DiscountCode?  @relation(fields: [discountCodeId], references: [id])
  cancelledBy   User?          @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  tickets       Ticket[]
  foodPurchases FoodPurchase[]

  @@index([userId])
  @@index([eventId, status])
  @@index([status, expiresAt])
}

model OrderItem {
  id            String        @id @default(cuid())
  orderId       String
  kind          OrderItemKind
  description   String // copied at purchase time
  unitPriceOre  Int
  quantity      Int           @default(1)
  ticketTypeId  String?
  foodPackageId String?
  foodVariantId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType  TicketType?  @relation(fields: [ticketTypeId], references: [id])
  foodPackage FoodPackage? @relation(fields: [foodPackageId], references: [id])
  foodVariant FoodVariant? @relation(fields: [foodVariantId], references: [id])

  @@index([orderId])
}

model Payment {
  id          String      @id @default(cuid())
  orderId     String
  provider    String
  providerRef String
  kind        PaymentKind
  amountOre   Int
  status      String
  raw         Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([provider, providerRef])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String    @unique
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DiscountCode {
  id         String            @id @default(cuid())
  eventId    String
  code       String // unique per event, case-insensitively (raw index on eventId, lower(code))
  kind       DiscountKind
  value      Int // percent (1-100) or öre
  appliesTo  DiscountAppliesTo @default(ALL)
  maxUses    Int?
  usedCount  Int               @default(0)
  validFrom  DateTime?
  validUntil DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  event       Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypes DiscountCodeTicketType[]
  orders      Order[]

  @@index([eventId])
}

model DiscountCodeTicketType {
  id           String   @id @default(cuid())
  codeId       String
  ticketTypeId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  code       DiscountCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  ticketType TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@unique([codeId, ticketTypeId])
}

// ───────────────────────── Email ─────────────────────────

model EmailOutbox {
  id        String      @id @default(cuid())
  to        String
  template  String
  locale    String      @default("sv")
  payload   Json
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  sentAt    DateTime?
  error     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
}

model Broadcast {
  id             String   @id @default(cuid())
  eventId        String
  subject        String
  body           String
  sentById       String
  recipientCount Int
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentBy User  @relation(fields: [sentById], references: [id])
}

/// One editable FAQ entry. The English text is optional: an empty one falls back to Swedish.
model FaqItem {
  id         String   @id @default(cuid())
  group      FaqGroup
  questionSv String
  answerSv   String
  questionEn String   @default("")
  answerEn   String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([group, sortOrder])
}

/// A crew job anyone may apply to while it is open.
model CrewJob {
  id            String   @id @default(cuid())
  title         String
  description   String
  titleEn       String   @default("")
  descriptionEn String   @default("")
  before        Boolean  @default(false) // needed before the event
  during        Boolean  @default(true) // needed during the event
  after         Boolean  @default(false) // needed after the event
  spots         Int? // how many people are needed; null = not stated
  isOpen        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  applications CrewApplication[]

  @@index([isOpen, sortOrder])
}

model CrewApplication {
  id           String                @id @default(cuid())
  jobId        String
  userId       String
  message      String
  availability String
  status       CrewApplicationStatus @default(NEW)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  job  CrewJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
}

enum SponsorTier {
  MAIN // huvudsponsor
  LARGE // stor sponsor
  REGULAR // sponsor
}

/// A sponsor whose logo is shown at the bottom of the landing page, grouped by tier.
model Sponsor {
  id        String      @id @default(cuid())
  name      String
  tier      SponsorTier
  logoPath  String // "/uploads/sponsors/<hex>.<ext>"
  url       String? // optional link, http(s) only
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([tier, sortOrder])
}
